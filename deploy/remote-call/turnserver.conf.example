# Template only. Set the public IP, DNS realm, certificate paths and shared
# secret before use. The empty/missing secret is not a deployable configuration.
listening-port=3478
tls-listening-port=5349
realm=turn.example.com
fingerprint
use-auth-secret
# static-auth-secret must equal the private Relay issuer JSON secret.
# static-auth-secret=<generated random hex string>
# external-ip=<public-ip>[/<private-ip>] when the server itself is behind NAT.
cert=/etc/djonehub/tls/fullchain.pem
pkey=/etc/djonehub/tls/privkey.pem
min-port=49160
max-port=49259
no-multicast-peers
no-tcp-relay
# Coturn 4.18: CLI/DTLS are disabled and TLS minimum is 1.2 by default.
# Do not enable cli, dtls, tlsv1 or tlsv1_1. The installer adds explicit
# disable flags only when the installed binary advertises those legacy options.
# TURN/TCP and TURN/TLS still carry UDP relay allocations; no-tcp-relay only
# disables RFC 6062 TCP peer allocations.
user-quota=4
total-quota=100
max-bps=32000
bps-capacity=2000000
# Deny peer destinations into internal, loopback, link-local and multicast nets.
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=224.0.0.0-255.255.255.255
denied-peer-ip=::1
denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=ff00::-ffff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
