# Separate administration vhost. Replace certificate paths with the real
# certificate for this hostname; do not paste this into the existing site's vhost.
server {
    listen 443 ssl;
    server_name relay-admin.oops.work;
    ssl_certificate /REPLACE/admin/fullchain.pem;
    ssl_certificate_key /REPLACE/admin/privkey.pem;
    client_max_body_size 32k;

    location / {
        proxy_pass http://127.0.0.1:18444;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_http_version 1.1;
        proxy_read_timeout 20s;
    }
}
